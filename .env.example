# ========================================================
# CAREERPILOT AI - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# Exposed to browser bundle
VITE_API_BASE_URL=https://careerpilot-api.onrender.com/api

# 2. SPRING BOOT BACKEND ENVIRONMENT VARIABLES (Render)
PORT=8080
DATABASE_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.your_supabase_id
DATABASE_PASSWORD=your_supabase_password
DATABASE_DRIVER=org.postgresql.Driver
AI_SERVICE_URL=https://careerpilot-ai.onrender.com
CORS_ALLOWED_ORIGINS=https://careerpilot-web.vercel.app,http://localhost:5173
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
UPLOAD_DIR=/tmp/uploads

# External Job Provider API Credentials (Optional - Auto-enables when configured)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=
NAUKRI_API_KEY=
NAUKRI_API_SECRET=
INTERNSHALA_API_KEY=
INTERNSHALA_API_SECRET=

# 3. PYTHON FASTAPI AI SERVICE ENVIRONMENT VARIABLES (Render)
# Server-side ONLY - NEVER expose GEMINI_API_KEY to frontend!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
CORS_ALLOWED_ORIGINS=https://careerpilot-web.vercel.app,https://careerpilot-api.onrender.com,http://localhost:5173
