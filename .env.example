# ==========================================
# CAREERPILOT AI ENVIRONMENT CONFIGURATION
# ==========================================

# Google Gemini API Settings (Server-side only, NEVER expose to Frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# RAG & Embedding Settings
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# PostgreSQL & Vector Database Settings
DATABASE_URL=jdbc:postgresql://localhost:5432/careerpilot
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Spring Boot JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Inter-Service Communication URLs
SPRING_BACKEND_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Application Settings
LOG_LEVEL=INFO
